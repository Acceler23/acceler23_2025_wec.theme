{
    "BlockRoot": {
        "BlockType": "canvas",
        "Width": 1200,
        "Height": 1500,
        "Items": [
            {
                "BlockType": "itemstack",
                "PositionX": 70,
                "Orientation": "Vertical",
                "ItemStackOptions": {
                    "ItemSource": "{Lineups.Lineups}",
                    "Limit": 6,
                    "ItemTemplate": {
                        "BlockType": "canvas",
                        "Width": 1058,
                        "Height": 173,
                        "Items": [
                            {
                                "BlockType": "image",
                                "Source": "Media/lineup_background",
                                "Colorize": {
                                    "Color": "{Item.Team.Color}"
                                },
                                "Triggers": [
                                    {
                                        "Condition": "{Season.LineupsBasedType, Converter=EnumEquals, Parameter=Cars}",
                                        "Property": "Colorize.Color",
                                        "Value": "{Item.Car.Color}"
                                    }
                                ]
                            },
                            {
                                "BlockType": "image",
                                "Source": "Media/lineup_foreground"
                            },
                            {
                                "BlockType": "dock",
                                "PositionY": 6,
                                "PositionX": 0,
                                "Width": 254,
                                "Height": 159,
                                "Items": [
                                    {
                                        "BlockType": "image",
                                        "Source": "{Item.Team.LogotypePath}",
                                        "VerticalAlignment": "Center",
                                        "HorizontalAlignment": "Center",
                                        "Height": 100,
                                        "Triggers": [
                                            {
                                                "Condition": "{Season.LineupsBasedType, Converter=EnumEquals, Parameter=Cars}",
                                                "Property": "Source",
                                                "Value": "{Item.Car.Vendor.LogotypePath}"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "BlockType": "dock",
                                "Height": 159,
                                "Width": 238,
                                "PositionX": 254,
                                "PositionY": 6,
                                "Items": [
                                    {
                                        "BlockType": "stack",
                                        "Orientation": "Horizontal",
                                        "VerticalAlignment": "Center",
                                        "HorizontalAlignment": "Center",
                                        "Items": [
                                            {
                                                "BlockType": "text",
                                                "VerticalAlignment": "Center",
                                                "HorizontalAlignment": "Center",
                                                "Source": "N°",
                                                "FontSize": 30,
                                                "Padding": "5",
                                                "FontName": "{Archivo_Condensed_Light}",
                                                "Foreground": "{White}",
                                                "Opacity": 50
                                            },
                                            {
                                                "BlockType": "text",
                                                "HorizontalAlignment": "Center",
                                                "VerticalAlignment": "Center",
                                                "Source": "[{Item.{CarNumber}}]",
                                                "FontName": "{Druk_Condensed_Super}",
                                                "FontSize": 95,
                                                "Padding": "5",
                                                "MarginTop": 10
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                }
            }
        ]
    }
}