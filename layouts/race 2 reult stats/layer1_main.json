                                                        "BlockType": "component",
                                                        "Component": "table_driver_racestats",
                                                        "RenderIf": "{RaceStatsCollum1, Converter=StringNotEquals, Parameter=none}",
                                                        "ComponentOptions": {
                                                            "Vars": {
                                                                "data": "{Item.{RaceStatsCollum1}}",
                                                                "dataString": "{RaceStatsCollum1}"
                                                            }
                                                        }
                                                    }
                                                },
                                                {
                                                    "Header": "[{RaceStatsCollum2, Converter=StringToUpperString}]",
                                                    "IsStretchWidth": true,
                                                    "Template": {
                                                        "BlockType": "component",
                                                        "Component": "table_driver_racestats",
                                                        "RenderIf": "{RaceStatsCollum2, Converter=StringNotEquals, Parameter=none}",
                                                        "ComponentOptions": {
                                                            "Vars": {
                                                                "data": "{Item.{RaceStatsCollum2}}",
                                                                "dataString": "{RaceStatsCollum2}"
                                                            }
                                                        }
                                                    }
                                                },
                                                {
                                                    "Header": "[{RaceStatsCollum3, Converter=StringToUpperString}]",
                                                    "IsStretchWidth": true,
                                                    "Template": {
                                                        "BlockType": "component",
                                                        "Component": "table_driver_racestats",
                                                        "RenderIf": "{RaceStatsCollum3, Converter=StringNotEquals, Parameter=none}",
                                                        "ComponentOptions": {
                                                            "Vars": {
                                                                "data": "{Item.{RaceStatsCollum3}}",
                                                                "dataString": "{RaceStatsCollum3}"
                                                            }
                                                        }
                                                    }
                                                },
                                                {
                                                    "Header": "[{RaceStatsCollum4, Converter=StringToUpperString}]",
                                                    "IsStretchWidth": true,
                                                    "Template": {
                                                        "BlockType": "component",
                                                        "Component": "table_driver_racestats",
                                                        "RenderIf": "{RaceStatsCollum4, Converter=StringNotEquals, Parameter=none}",
                                                        "ComponentOptions": {
                                                            "Vars": {
                                                                "data": "{Item.{RaceStatsCollum4}}",
                                                                "dataString": "{RaceStatsCollum4}"
                                                            }
                                                        }
                                                    }
                                                },
                                                {
                                                    "Header": "[{RaceStatsCollum5, Converter=StringToUpperString}]",
                                                    "IsStretchWidth": true,
                                                    "Template": {
                                                        "BlockType": "component",
                                                        "Component": "table_driver_racestats",
                                                        "RenderIf": "{RaceStatsCollum5, Converter=StringNotEquals, Parameter=none}",
                                                        "ComponentOptions": {
                                                            "Vars": {
                                                                "data": "{Item.{RaceStatsCollum5}}",
                                                                "dataString": "{RaceStatsCollum5}"
                                                            }
                                                        }
                                                    }
                                                }
                                            ]
                                        }
                                    }
                                ]
                            },
                            {
                                "BlockType": "shape",
                                "Margin": "70, 20, 70, 0",
                                //"PositionX": 70,
                                //"PositionY": 906,
                                "Width": 1235,
                                "Height": 2,
                                "Opacity": 30,
                                "ShapeOptions": {
                                    "Fill": "{White}",
                                    "ShapeType": "rectangle"
                                }
                            },
                            {
                                "BlockType": "component",
                                "Component": "bottom_table",
                                "Padding": "60, 20, 60, 0",
                                "VerticalAlignment": "Bottom"
