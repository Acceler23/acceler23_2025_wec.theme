                                                        "BlockType": "component",
                                                        "Component": "table_driver",
                                                        "Width": 400,
                                                        "ComponentOptions": {
                                                            "Vars": {
                                                                "renderDriver1": true
                                                            }
                                                        }
                                                    }
                                                },
                                                {
                                                    "Header": "[{RaceStatsCollum1, Converter=StringToUpperString}]",
