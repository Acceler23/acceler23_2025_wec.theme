{
    "BlockRoot": {
        "Name": "mainStack",
        "BlockType": "dock",
        "Width": "{RenderWidth}",
        "Height": "{RenderHeight}",
        "Margin": "20, 60",
        "Items": [
            {
                "BlockType": "stack",
                "HorizontalAlignment": "Center",
                "VerticalAlignment": "Center",
                "Height": "{TableHeight}",
                "BackgroundImage": "Session/Session_bg.png",
                "BackgroundImageOpacity": 60,
                "ColorizeBackground": {
                    "Color": "{DarkBlue}"
                },
                "Orientation": "Vertical",
                "Items": [
                    {
                        "BlockType": "stack",
                        "Orientation": "Vertical",
                        "HorizontalAlignment": "Center",
                        "BackgroundImage": "Session/table_shade.png",
                        "ColorizeBackground": {
                            "Color": "{LightBlue}"
                        },
                        "Items": [
                            {
                                "BlockType": "component",
                                "Component": "session_head",
                                "Padding": "120, 60, 120, 0",
                                //"PositionX": 118,
                                //"PositionY": 60,
                                "ComponentOptions": {
                                    "Vars": {
                                        "sessionInfo": "STATISTICS"
                                    }
                                }
                            },
                            {
                                "BlockType": "shape",
                                "Margin": "120, 10, 120, 0",
                                //"PositionX": 120,
                                //"PositionY": 140,
                                "Width": 1145,
                                "Height": 2,
                                "Opacity": 30,
                                "ShapeOptions": {
                                    "Fill": "{LightBlue}",
                                    "ShapeType": "rectangle"
                                }
                            },
                            {
                                "BlockType": "dock",
                                "Padding": "120, 20, 120, 0",
                                //"PositionX": 120,
                                //"PositionY": 173,
                                "Width": "*",
                                "Height": 38,
                                "Items": [
                                    {
                                        "BlockType": "text",
                                        "Source": "[{Session.RacingClass.Name, Converter=StringToUpperString}]",
                                        "FontName": "{Druk_Wide_Bold_Italic}",
                                        "FontSize": 25,
                                        "Height": 38,
                                        "MarginTop": 4,
                                        "VerticalAlignment": "Center",
                                        "HorizontalAlignment": "Left",
                                        "Padding": "7",
                                        "Background": "{Session.RacingClass.Color}",
                                        "Foreground": "{Session.RacingClass.SecondaryColor}",
                                        "TextOptions": {
                                            "VerticalAlignment": "Bottom"
                                        }
                                    },
                                    {
                                        "BlockType": "text",
                                        "Source": "[{Session.Track.CircuitFullName, Converter=StringToUpperString}]",
                                        "FontName": "{Druk_Wide_Bold_Italic}",
                                        "FontSize": 25,
                                        "Height": 38,
                                        "VerticalAlignment": "Center",
                                        "HorizontalAlignment": "Right",
                                        "MarginTop": 4,
                                        "Padding": "5",
                                        "Triggers": [
                                            {
                                                "Trigger": "NameDescription"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "BlockType": "stack",
                                "Height": 640,
                                "Margin": "40, 40, 0, 0",
                                //"PositionX": 0,
                                //"PositionY": 236,
                                "Items": [
                                    {
                                        "BlockType": "table",
                                        "Height": 640,
                                        "Width": 1250,
                                        "Triggers": [
                                            {
                                                "Trigger": "TableParts"
                                            }
                                        ],
                                        "TableOptions": {
                                            "ItemsSource": "{Session.Drivers}",
                                            "IndexStart": 0,
                                            "IndexEnd": 9,
                                            "RowSpacing": 12,
                                            "HeaderTemplate": {
                                                "BlockType": "text",
                                                "Padding": "10,5",
                                                "VerticalAlignment": "Bottom",
                                                "HorizontalAlignment": "Center",
                                                "FontName": "{Archivo_SemiBold_Italic}"
                                            },
                                            "Columns": [
                                                {
                                                    "Header": "",
                                                    "Template": {
                                                        "BlockType": "component",
                                                        "Component": "table_position"
                                                    }
                                                },
                                                {
                                                    "Header": "",
                                                    "Template": {
                                                        "BlockType": "component",
                                                        "Component": "table_logo"
                                                    }
                                                },
                                                {
                                                    "Header": "",
                                                    "Template": {
                                                        "BlockType": "component",
                                                        "Component": "table_number"
                                                    }
                                                },
                                                {
                                                    "Header": "",
                                                    "Template": {
                                                        "BlockType": "component",
                                                        "Component": "teamcar_color"
                                                    }
                                                },
                                                {
