{
    "ComponentName": "table_points_pp",
    "BlockType": "dock",
    "Height": 92,
    "Width": 235,
    "Background": "{GreyBlue}",
    "Triggers": [
        {
            "Condition": "{Item.Index, Converter=NumberIsOdd}",
            "Property": "Background",
            "Value": "{DarkBlue}"
        }
    ],
    "Items": [
        {
            "BlockType": "text",
            "Source": "{Item.PointsString}",
            "FontName": "{Archivo_Condensed_BoldItalic}",
            "FontSize": 55,
            "Height": 45,
            "VerticalAlignment": "Center",
            "HorizontalAlignment": "Center",
            "Triggers": [
                {
                    "Condition": "{Item.PointsString, Converter=StringEquals, Parameter=0}",
                    "Setters": [
                        {
                            "Property": "Source",
                            "Value": "."
                        },
                        {
                            "Property": "FontSize",
                            "Value": 3
                        },
                        {
                            "Property": "Foreground",
                            "Value": "{DarkBlue}"
                        }
                    ]
                }
            ]
        }
    ]
}