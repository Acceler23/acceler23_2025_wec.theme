{
    "ComponentName": "standings_pp_header",
    "BlockType": "dock",
    "Height": 220,
    "Items": [
        {
            "BlockType": "stack",
            "Height": 220,
            "MaxWidth": 800,
            "HorizontalAlignment": "Left",
            "BackgroundImage": "media/standings_pp_head",
            "Items": [
                {
                    "BlockType": "image",
                    "Source": "{Season.LeagueInfo.LeagueLogo}",
                    "Height": 150,
                    "HorizontalAlignment": "Left",
                    "VerticalAlignment": "Center",
                    "Padding": "90, 0, 200, 0"
                }
            ]
        },
        {
            "BlockType": "stack",
            "RenderIf": "{PageRender, Converter=NumberNotEquals, Parameter=1}",
            "Orientation": "Vertical",
            "VerticalAlignment": "Center",
            "HorizontalAlignment": "Right",
            "PaddingRight": 40,
            "Items": [
                {
                    "BlockType": "text",
                    "Source": "{Season.Name, Converter=StringToUpperString} [SEASON]",
                    "FontName": "{Archivo_Condensed_ExtraBoldItalic}",
                    "HorizontalAlignment": "Center",
                    "VerticalAlignment": "Center",
                    "Padding": "10",
                    "FontSize": 100
                },
                {
                    "BlockType": "stack",
                    "Orientation": "Horizontal",
                    "HorizontalAlignment": "Center",
                    "VerticalAlignment": "Center",
                    "Items": [
                        {
                            "BlockType": "text",
                            "Source": ">>>",
                            "FontName": "{Archivo_Condensed_ExtraBoldItalic}",
                            "HorizontalAlignment": "Center",
                            "VerticalAlignment": "Center",
                            "Padding": "10",
                            "FontSize": 20
                        },
                        {
                            "BlockType": "text",
                            "Source": "[{Standings.RacingClass.Name, Converter=StringToUpperString}] [IN NUMBERS]",
                            "FontName": "{Archivo_Condensed_ExtraBoldItalic}",
                            "HorizontalAlignment": "Center",
                            "VerticalAlignment": "Center",
                            "Padding": "10",
                            "FontSize": 45
                        }
                    ]
                }
            ]
        }
    ]
}