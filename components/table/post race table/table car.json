{
    "ComponentName": "table_car",
    "BlockType": "dock",
    "RenderIf": "<renderCar1>",
    "Background": "{DarkBlue}",
    "Height": "{TableLineHeight}",
    "StretchWidth": true,
    "Items": [
        {
            "BlockType": "stack",
            "HorizontalAlignment": "Left",
            "Items": [
                {
                    "BlockType": "text",
                    "Source": "[Short {Item.Car.Vendor.Name}]",
                    "Style": "Session_Style",
                    "FontName": "{Archivo_BlackItalic}",
                    "Width": 60,
                    "PaddingLeft": 20,
                    "Triggers": [
                        {
                            "Trigger": "LeaderColorTeam"
                        },
                        {
                            "Trigger": "LeaderColorCar"
                        }
                    ]
                },
                {
                    "BlockType": "text",
                    "Source": "[{Item.Driver.{NameConvention}, Converter=StringToUpperString}]",
                    "Style": "Session_Style",
                    "FontName": "{Archivo_BlackItalic}",
                    "PaddingLeft": 20,
                    "Triggers": [
                        {
                            "Trigger": "LeaderColorTeam"
                        },
                        {
                            "Trigger": "LeaderColorCar"
                        }
                    ]
                }
            ]
        },
        {
            "BlockType": "text",
            "Source": "",
            "Background": "{DarkBlue}",
            "Style": "Session_Style",
            "HorizontalAlignment":"Right",
            "PaddingRight": 50,
            "Triggers": [
                {
                    "Condition": "{Item.Car.CarClass.Name, Converter=StringEquals, Parameter=Le Mans Hypercar}",
                    "ConditionAnd": "{Item.Car.Name, Converter=StringNotEquals, Parameter=Aston Martin Valkyrie}",
                    "Property": "Source",
                    "Value": "HY"
                },
                {
                    "Condition": "{Item.Team.Car.CarClass.Name, Converter=StringEquals, Parameter=Le Mans Hypercar}",
                    "ConditionAnd": "{Item.Team.Car.Name, Converter=StringNotEquals, Parameter=Aston Martin Valkyrie}",
                    "Property": "Source",
                    "Value": "HY"
                },
                {
                    "Trigger": "LeaderColorTeam"
                },
                {
                    "Trigger": "LeaderColorCar"
                }
            ]
        }
    ],
    "Triggers": [
        {
            "Trigger": "LeaderColorTeam"
        },
        {
            "Trigger": "LeaderColorCar"
        }
    ]
}